{
  "openapi": "3.0.1",
  "info": {
    "title": "Activity Logs",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [],
  "paths": {
    "/": {
      "get": {
        "summary": "activity-logs (list)",
        "deprecated": false,
        "description": "Returns CRM activity logs ordered newest first. The endpoint supports filtering by subjects, event, causer, and creation date.",
        "tags": [],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "",
            "example": "Bearer {{token}}",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subjects[]",
            "in": "query",
            "description": "Subject filters in type:id format. Supported types: account, contact, deal, lead, property, user.",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^(account|contact|deal|lead|property|user):[1-9][0-9]*$"
              }
            },
            "example": [
              "lead:44",
              "account:12"
            ]
          },
          {
            "name": "event",
            "in": "query",
            "description": "",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "created",
                "updated",
                "deleted",
                "restored",
                "reverted",
                "roles_updated",
                "password_updated"
              ]
            }
          },
          {
            "name": "causer_id",
            "in": "query",
            "description": "",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Include activities created at or after this date-time.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Include activities created at or before this date-time.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActivityLog"
                      }
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "first": {
                          "type": "string"
                        },
                        "last": {
                          "type": "string"
                        },
                        "prev": {
                          "type": "null"
                        },
                        "next": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "first",
                        "last",
                        "prev",
                        "next"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "from": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "page": {
                                "type": "integer",
                                "nullable": true
                              },
                              "active": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "url",
                              "label",
                              "page",
                              "active"
                            ]
                          }
                        },
                        "path": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "to": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "current_page",
                        "from",
                        "last_page",
                        "links",
                        "path",
                        "per_page",
                        "to",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/{id}": {
      "get": {
        "summary": "activity-logs (show)",
        "deprecated": false,
        "description": "",
        "tags": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "bignum"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "",
            "example": "Bearer {{token}}",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activity_log": {
                      "$ref": "#/components/schemas/ActivityLog"
                    }
                  },
                  "required": [
                    "activity_log"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/{id}/revert": {
      "post": {
        "summary": "activity-logs (revert)",
        "deprecated": false,
        "description": "Reverts the latest CRM update or soft deletion for the activity's subject.",
        "tags": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "bignum"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "",
            "example": "Bearer {{token}}",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                },
                "required": [
                  "reason"
                ]
              },
              "example": {
                "reason": "The lead was updated by mistake."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activity_log": {
                      "$ref": "#/components/schemas/ActivityLog"
                    }
                  },
                  "required": [
                    "activity_log"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "ID",
            "readOnly": true
          },
          "event": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "deleted",
              "restored",
              "reverted",
              "roles_updated",
              "password_updated"
            ]
          },
          "description": {
            "type": "string"
          },
          "subject": {
            "$ref": "#/components/schemas/ActivitySubject"
          },
          "causer": {
            "$ref": "#/components/schemas/ActivityCauser"
          },
          "changes": {
            "$ref": "#/components/schemas/ActivityChanges"
          },
          "metadata": {
            "$ref": "#/components/schemas/ActivityMetadata"
          },
          "revert": {
            "$ref": "#/components/schemas/ActivityRevert"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "event",
          "description",
          "subject",
          "causer",
          "changes",
          "metadata",
          "revert",
          "created_at"
        ]
      },
      "ActivitySubject": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "account",
              "contact",
              "deal",
              "lead",
              "property",
              "user"
            ],
            "nullable": true
          },
          "id": {
            "type": "integer",
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "type",
          "id",
          "label"
        ]
      },
      "ActivityCauser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ActivityChanges": {
        "type": "object",
        "properties": {
          "before": {
            "type": "object",
            "additionalProperties": true
          },
          "after": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "before",
          "after"
        ]
      },
      "ActivityMetadata": {
        "type": "object",
        "properties": {
          "reverted_activity_id": {
            "type": "integer",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "restored_attributes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "reverted_activity_id",
          "reason",
          "restored_attributes"
        ]
      },
      "ActivityRevert": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "allowed"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {}
  },
  "servers": [],
  "security": []
}
