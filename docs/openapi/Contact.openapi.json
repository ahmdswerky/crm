  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "format": "bignum"
          },
          "name": {
            "type": "string"
          },
          "industry": {
            "type": "string",
            "example": "Development"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "image": {
            "allOf": [
              { "$ref": "#/components/schemas/Media" }
            ],
            "nullable": true,
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "industry",
          "phone",
          "address",
          "name"
        ]
      },
      "AccountDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Account"
          },
          {
            "type": "object",
            "properties": {
              "contacts_count": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true
              }
            },
            "required": [
              "contacts_count"
            ]
          }
        ]
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "uuid": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "mime_type": { "type": "string" },
          "size": { "type": "integer", "format": "int64" },
          "url": { "type": "string", "format": "uri" },
          "thumbnail_url": { "type": "string", "format": "uri" },
          "order": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "uuid", "name", "mime_type", "size", "url", "thumbnail_url", "order", "created_at"]
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "format": "bignum"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string"
          },
          "lead_id": {
            "type": "integer",
            "format": "bignum",
            "readOnly": true
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "lead": {
            "$ref": "#/components/schemas/Lead",
            "nullable": true,
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "phone",
          "name"
        ]
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "format": "bignum"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "contacted",
              "qualified",
              "unqualified"
            ]
          },
          "city": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "company_name": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "facebook",
              "whatsapp",
              "instagram",
              "x"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "status",
          "city"
        ]
      }
    },
