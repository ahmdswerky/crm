          "id",
          "kind",
          "subject",
          "details",
          "status",
          "creator_id",
          "assignee_id",
          "outcome",
          "summary",
          "version",
          "due_date",
          "starts_at",
          "ends_at",
          "occurred_at",
          "links",
          "assignee_name"
        ]
      },
      "Activity": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ActivitySnapshot"
          },
          {
            "type": "object",
            "properties": {
              "creator": {
                "$ref": "#/components/schemas/ActivityPerson"
