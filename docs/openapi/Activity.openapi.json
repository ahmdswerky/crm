                "format": "date-time",
                "nullable": true
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "can_edit": {
                "type": "boolean"
              },
              "can_reassign": {
                "type": "boolean"
              }
            },
            "required": [
              "creator",
              "assignee",
              "created_at",
              "updated_at",
              "can_edit",
              "can_reassign"
            ]
          }
        ]
      },
      "InteractionHistoryEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "activity_id": {
            "type": "integer"
          },
          "actor_id": {
            "type": "integer"
          },
          "actor_name": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "completed",
              "cancelled",
              "voided",
              "reassigned",
              "corrected",
              "scheduled"
            ]
          },
          "before": {
            "description": "Empty array on creation; otherwise original immutable snapshot.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ActivitySnapshot"
              },
              {
                "type": "array",
                "items": {}
              }
            ]
          },
          "after": {
            "$ref": "#/components/schemas/ActivitySnapshot"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "event_id",
          "activity_id",
          "actor_id",
          "actor_name",
          "action",
          "before",
          "after",
          "occurred_at",
          "created_at"
        ]
      },
