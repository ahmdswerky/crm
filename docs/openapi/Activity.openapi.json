{
  "openapi": "3.0.1",
  "info": {
    "title": "Sales Activities",
    "version": "1.0.0",
    "description": "Manual CRM interactions and their independent history. No developer Activity Logs are read, returned, or written. All linked records must be viewable. Corrections retain immutable snapshots; no delete. Tasks may use a date-only deadline in Africa/Cairo; timestamp fields require an explicit UTC offset. Completed calls need reached/unanswered/busy/voicemail/wrong_number; meetings/viewings need attended/no_show. These three kinds also require summary. Notes are completed. One active agent, default current if eligible. Creator or activity.manage may reassign. Existing links/kind are fixed; void misfiled completed entries. Scheduled to completed/cancelled, completed to voided, cancelled to scheduled/voided. Voided is final. Activity manager uses activity.manage; otherwise creator/assignee requires activity.edit. History includes lead-origin entries when filtering a converted contact. Deal options suggest contact/property for explicit confirmation. History stays readable while its after-commit job is pending."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/activities": {
      "get": {
