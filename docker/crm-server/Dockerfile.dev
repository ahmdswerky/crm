FROM php:8.4-fpm-alpine@sha256:5992f8b7433fe7fa96dfbf67746c86d6c41bc91e686eac38fe531c72a02e40e4

ARG APP_UID=1000
ARG APP_GID=1000

RUN apk add --no-cache \
        bash \
        icu-libs \
        libjpeg-turbo \
        libpng \
        libwebp \
        libpq \
        libzip \
        freetype \
        libxml2 \
        oniguruma \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        icu-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libwebp-dev \
        postgresql-dev \
        libzip-dev \
        freetype-dev \
        libxml2-dev \
        oniguruma-dev \
        linux-headers \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(getconf _NPROCESSORS_ONLN)" bcmath dom exif gd intl pcntl pdo_pgsql posix sockets zip \
    && pecl install redis-6.2.0 \
    && docker-php-ext-enable redis opcache \
    && php -m | grep -qx gd \
    && php -m | grep -qx sockets \
    && php -r 'exit(function_exists("imagewebp") ? 0 : 1);' \
    && apk del .build-deps \
    && addgroup -g "$APP_GID" app \
    && adduser -D -H -u "$APP_UID" -G app app

COPY --from=docker.io/library/composer:2.8@sha256:5248900ab8b5f7f880c2d62180e40960cd87f60149ec9a1abfd62ac72a02577c /usr/bin/composer /usr/bin/composer

COPY docker/crm-server/php.dev.ini /usr/local/etc/php/conf.d/99-crm.ini
COPY docker/crm-server/www.dev.conf /usr/local/etc/php-fpm.d/zz-crm.conf
COPY docker/crm-server/entrypoint.dev.sh /usr/local/bin/crm-dev-entrypoint
RUN chmod 0755 /usr/local/bin/crm-dev-entrypoint

WORKDIR /var/www/html
COPY --chown=app:app server/composer.json server/composer.lock ./
RUN composer install --prefer-dist --no-interaction --no-progress --no-scripts
COPY --chown=app:app server/ .
RUN composer dump-autoload --no-interaction --no-scripts \
    && php artisan package:discover --ansi

RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs storage/media-library/temp bootstrap/cache storage/app/public \
    && rm -rf public/storage \
    && ln -s /var/www/html/storage/app/public public/storage \
    && chown -R app:app storage bootstrap/cache

USER app
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/crm-dev-entrypoint"]
CMD ["php-fpm", "-F"]
