# Template only. Production ACLs are generated by docker/redis/entrypoint.sh
# from mounted secret files. Passwords must contain no whitespace or newlines.
user default off
user crm on >replace-with-crm-password ~crm:* &crm:* +@all -@dangerous
user payments on >replace-with-payments-password ~payments:* &payments:* +@all -@dangerous
