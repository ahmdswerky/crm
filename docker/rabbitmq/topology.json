{
  "rabbit_version": "4.1.0",
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    { "name": "payments.commands", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "payments.commands.retry", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "payments.commands.dead", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "payments.events", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "payments.events.dead", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "payments", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "payments.commands.dead" } },
    { "name": "payments.retry", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-message-ttl": 10000, "x-dead-letter-exchange": "payments.commands" } },
    { "name": "payments.dead", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "crm.payment-events", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "payments.events.dead" } },
    { "name": "crm.payment-events.dead", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "payments.commands", "vhost": "/", "destination": "payments", "destination_type": "queue", "routing_key": "invoice.generate", "arguments": {} },
    { "source": "payments.commands.retry", "vhost": "/", "destination": "payments.retry", "destination_type": "queue", "routing_key": "invoice.generate", "arguments": {} },
    { "source": "payments.commands.dead", "vhost": "/", "destination": "payments.dead", "destination_type": "queue", "routing_key": "invoice.generate", "arguments": {} },
    { "source": "payments.events", "vhost": "/", "destination": "crm.payment-events", "destination_type": "queue", "routing_key": "invoice.completed", "arguments": {} },
    { "source": "payments.events", "vhost": "/", "destination": "crm.payment-events", "destination_type": "queue", "routing_key": "invoice.failed", "arguments": {} },
    { "source": "payments.events.dead", "vhost": "/", "destination": "crm.payment-events.dead", "destination_type": "queue", "routing_key": "invoice.completed", "arguments": {} },
    { "source": "payments.events.dead", "vhost": "/", "destination": "crm.payment-events.dead", "destination_type": "queue", "routing_key": "invoice.failed", "arguments": {} }
  ]
}
