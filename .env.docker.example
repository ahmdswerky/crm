COMPOSE_PROJECT_NAME=crm
APP_URL=https://crm.example.com
LOG_LEVEL=info
# Development-only Laravel PHP-FPM worker count.
PHP_FPM_MAX_CHILDREN=4

CRM_DB_NAME=crm
CRM_DB_USER=crm_app
PAYMENTS_DB_NAME=payments
PAYMENTS_DB_USER=payments_app
PAYMENTS_AUTH_DB_NAME=crm
PAYMENTS_AUTH_DB_USER=auth_reader
PAYMENTS_AUTH_DB_SEED_USER=auth_seeder
PAYMENTS_AUTH_SEED_ROLE_NAMES=manager,agent

# These paths are host paths, not secret values. Keep the actual files outside Git.
LARAVEL_APP_KEY_FILE=.secrets/laravel_app_key
POSTGRES_PASSWORD_FILE=.secrets/postgres_password
CRM_DB_PASSWORD_FILE=.secrets/crm_db_password
PAYMENTS_DB_PASSWORD_FILE=.secrets/payments_db_password
PAYMENTS_AUTH_DB_PASSWORD_FILE=.secrets/auth_db_password
PAYMENTS_AUTH_DB_SEED_PASSWORD_FILE=.secrets/auth_seed_db_password
CRM_REDIS_PASSWORD_FILE=.secrets/crm_redis_password
PAYMENTS_REDIS_PASSWORD_FILE=.secrets/payments_redis_password
RABBITMQ_USER=crm
RABBITMQ_PASSWORD_FILE=.secrets/rabbitmq_password
